# By Solar - Environment Variables
# Copy this file to .env and fill in the values

# Formspree Form IDs (get from https://formspree.io)
FORMSPREE_QUOTE_ID=f/xxxxxxxxxxx
FORMSPREE_CONTACT_ID=f/xxxxxxxxxxx

# Claude API Key (for AI chatbot) - https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Server Configuration
PORT=3000
NODE_ENV=development

# Analytics (optional - set in HTML)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=xxxxxxxxxxx

# Payment Processing (Phase 6)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx
